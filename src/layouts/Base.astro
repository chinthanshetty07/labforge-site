---
interface Props { title: string; description: string; jsonLd?: object[] }
const { title, description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <style is:global>
      :root { --ink:#16202e; --muted:#5a6475; --accent:#1f5fd1; --surface:#f6f7f9; --line:#e2e5ea; --ok:#11743b; --err:#b42318; }
      * { box-sizing: border-box; }
      body { margin:0; font:16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; color:var(--ink); background:#fff; }
      main { max-width: 1040px; margin: 0 auto; padding: 0 16px 64px; }
      a { color: var(--accent); }
      a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      h1 { font-size: clamp(28px, 5vw, 44px); line-height: 1.15; margin: 48px 0 16px; }
      h2 { font-size: 24px; margin: 48px 0 12px; }
      .muted { color: var(--muted); }
      .btn { display:inline-block; background:var(--accent); color:#fff; padding:12px 20px; border-radius:8px; text-decoration:none; border:0; font:inherit; cursor:pointer; }
      .grid { display:grid; gap:16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
      .card { border:1px solid var(--line); border-radius:10px; padding:16px; background:var(--surface); }
      nav { max-width:1040px; margin:0 auto; padding:16px; display:flex; justify-content:space-between; align-items:center; }
      footer { border-top:1px solid var(--line); padding:24px 16px; text-align:center; color:var(--muted); font-size:14px; }
    </style>
  </head>
  <body>
    <nav aria-label="Main"><a href={base}><strong>LabForge</strong></a><a href={`${base}#demo`}>Book a demo</a></nav>
    <main><slot /></main>
    <footer>LabForge is a fictional product used to demonstrate a spec-driven, agent-built marketing site.</footer>
  </body>
</html>
